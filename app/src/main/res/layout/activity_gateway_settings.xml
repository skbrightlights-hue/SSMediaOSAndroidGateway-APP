<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:background="#F3F6FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="22dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SS MediaOS"
            android:textColor="#102A43"
            android:textSize="25sp"
            android:textStyle="bold"
            android:letterSpacing="0.01" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp"
            android:text="SMS Gateway • Device Settings"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_gateway_panel"
            android:elevation="2dp">

            <EditText
                android:id="@+id/serverUrlInput"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:singleLine="true" />

            <EditText
                android:id="@+id/deviceIdInput"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"
                android:importantForAutofill="no"
                android:inputType="text"
                android:singleLine="true"
                android:enabled="false"
                android:focusable="false" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Company API Key"
                android:textColor="#1E293B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/apiTokenInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:hint="Enter Company API Key"
                android:inputType="textPassword"
                android:singleLine="true"
                android:autofillHints="password"
                android:background="@drawable/bg_gateway_input" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Your API key remains masked."
                android:textColor="#64748B"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Organization Code"
                android:textColor="#1E293B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/organizationCodeInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:hint="Enter Organization Code"
                android:inputType="textCapCharacters"
                android:singleLine="true"
                android:importantForAutofill="no"
                android:background="@drawable/bg_gateway_input" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Registered Mobile Number"
                android:textColor="#1E293B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/registeredMobileInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:hint="Enter registered mobile number"
                android:inputType="phone"
                android:singleLine="true"
                android:autofillHints="phone"
                android:background="@drawable/bg_gateway_input" />

            <Button
                android:id="@+id/verifyMobileButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="Verify Organization &amp; Mobile"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:backgroundTint="#2457A6"
                android:textColor="#FFFFFF" />

            <!-- Organization identity card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:padding="15dp"
                android:background="@drawable/bg_gateway_identity">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SCHOOL / INSTITUTION"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/organizationNameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Not verified"
                    android:textColor="#102A43"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:maxLines="3"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="ORGANIZATION VERIFICATION"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/organizationStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_gateway_status_verified"
                    android:padding="13dp"
                    android:text="Organization Verification: PENDING"
                    android:textColor="#155E75"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Assigned SIM"
                android:textColor="#1E293B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/simSelectionSpinner"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:contentDescription="Select the assigned SIM for this gateway" />

            <TextView
                android:id="@+id/simStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_gateway_info"
                android:padding="13dp"
                android:text="SIM status: Not checked"
                android:textColor="#475569"
                android:textSize="13sp" />

            <Button
                android:id="@+id/saveSettingsButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="22dp"
                android:text="Save Settings"
                android:textAllCaps="false"
                android:backgroundTint="#E7EDF5"
                android:textColor="#243B53" />

            <Button
                android:id="@+id/testConnectionButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="Test Server Connection"
                android:textAllCaps="false"
                android:backgroundTint="#E7EDF5"
                android:textColor="#243B53" />

            <Button
                android:id="@+id/activateDeviceButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:text="Verify / Connect Device"
                android:textAllCaps="false"
                android:backgroundTint="#087F73"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/connectionStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="Connection status: Not tested"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/bg_gateway_device_status">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="GATEWAY DEVICE"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/activationStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Device status: NOT ACTIVATED"
                    android:textColor="#9A3412"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="SS MediaOS"
            android:textColor="#64748B"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
